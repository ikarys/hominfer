{
  "llama.cpp": {
    "label": "llama.cpp",
    "desc": {
      "en": "OpenAI server for GGUF models (LLM, vision). The most versatile: every quantization, partial GPU / RAM offload.",
      "fr": "Serveur OpenAI pour les modèles GGUF (LLM, vision). Le plus polyvalent : toutes les quantifications, déchargement partiel GPU / RAM."
    },
    "url": "https://github.com/ggml-org/llama.cpp",
    "dir": "~/llm/llama.cpp",
    "script": "llama.cpp.sh",
    "disk_gb": 3,
    "minutes": 15,
    "gpu": ["nvidia"],
    "engine": {
      "label": "llama.cpp",
      "kinds": ["llm"],
      "file_ext": [".gguf"],
      "command": ["~/llm/llama.cpp/build/bin/llama-server", "-m", "{file}", "--host", "0.0.0.0", "--port", "{port}",
                  "--alias", "{model_id}", "-ngl", "{ngl}", "-fa", "{flash_attn}", "-c", "{ctx}", "-np", "{parallel}"],
      "health": "/health",
      "endpoint": "/v1",
      "procs": ["llama-server"],
      "match_file": true,
      "repo": "~/llm/llama.cpp",
      "build": ["cmake", "--build", "build", "--target", "llama-server"],
      "binary": "build/bin/llama-server",
      "params": {
        "ctx": {"label": {"en": "Context (total, shared by sessions)", "fr": "Contexte (total, partagé entre sessions)"},
                "default": "0"},
        "parallel": {"label": {"en": "Parallel sessions", "fr": "Sessions parallèles"}, "default": "1"},
        "ngl": {"label": {"en": "GPU layers (999 = all)", "fr": "Couches sur GPU (999 = toutes)"}, "default": "999"},
        "flash_attn": {"label": "Flash attention", "default": "on",
                       "values": [["on", {"en": "on", "fr": "activée"}], ["off", {"en": "off", "fr": "désactivée"}],
                                  ["auto", "auto"]]}
      }
    }
  },
  "llama.cpp-vulkan": {
    "label": "llama.cpp (Vulkan)",
    "desc": {
      "en": "llama.cpp built with Vulkan: runs GGUF models on AMD and Intel GPUs (APUs included), and on NVIDIA without the CUDA toolkit. A little slower than CUDA on NVIDIA.",
      "fr": "llama.cpp compilé avec Vulkan : fait tourner les modèles GGUF sur les GPU AMD et Intel (APU compris), et sur NVIDIA sans le toolkit CUDA. Un peu plus lent que CUDA sur NVIDIA."
    },
    "url": "https://github.com/ggml-org/llama.cpp",
    "dir": "~/llm/llama.cpp-vulkan",
    "script": "llama.cpp-vulkan.sh",
    "disk_gb": 3,
    "minutes": 10,
    "engine": {
      "label": "llama.cpp (Vulkan)",
      "kinds": ["llm"],
      "file_ext": [".gguf"],
      "command": ["~/llm/llama.cpp-vulkan/build/bin/llama-server", "-m", "{file}", "--host", "0.0.0.0", "--port", "{port}",
                  "--alias", "{model_id}", "-ngl", "{ngl}", "-fa", "{flash_attn}", "-c", "{ctx}", "-np", "{parallel}"],
      "health": "/health",
      "endpoint": "/v1",
      "procs": ["llama-server"],
      "match_file": true,
      "repo": "~/llm/llama.cpp-vulkan",
      "build": ["cmake", "--build", "build", "--target", "llama-server"],
      "binary": "build/bin/llama-server",
      "params": {
        "ctx": {"label": {"en": "Context (total, shared by sessions)", "fr": "Contexte (total, partagé entre sessions)"},
                "default": "0"},
        "parallel": {"label": {"en": "Parallel sessions", "fr": "Sessions parallèles"}, "default": "1"},
        "ngl": {"label": {"en": "GPU layers (999 = all)", "fr": "Couches sur GPU (999 = toutes)"}, "default": "999"},
        "flash_attn": {"label": "Flash attention", "default": "on",
                       "values": [["on", {"en": "on", "fr": "activée"}], ["off", {"en": "off", "fr": "désactivée"}],
                                  ["auto", "auto"]]}
      }
    }
  },
  "vllm": {
    "label": "vLLM",
    "desc": {
      "en": "OpenAI server for safetensors models (whole Hugging Face repository), FP8 / NVFP4 / AWQ… Very fast with several sessions, but reserves the VRAM up front.",
      "fr": "Serveur OpenAI pour les modèles safetensors (dépôt Hugging Face complet), FP8 / NVFP4 / AWQ… Très rapide à plusieurs sessions, mais réserve la VRAM d'avance."
    },
    "url": "https://github.com/vllm-project/vllm",
    "dir": "~/llm/vllm",
    "detect": ".venv/bin/vllm",
    "script": "vllm.sh",
    "disk_gb": 12,
    "minutes": 10,
    "gpu": ["nvidia"],
    "engine": {
      "label": "vLLM",
      "kinds": ["llm"],
      "file_ext": [".safetensors"],
      "loads_dir": true,
      "command": ["~/llm/vllm/vllm-serve.sh", "{file_dir}", "--served-model-name", "{model_id}",
                  "--host", "0.0.0.0", "--port", "{port}", "--max-model-len", "{ctx}",
                  "--gpu-memory-utilization", "{gpu_mem}", "--max-num-seqs", "{parallel}", "--enable-prefix-caching"],
      "health": "/health",
      "endpoint": "/v1",
      "procs": ["vllm-serve.sh", "vllm"],
      "match_file": true,
      "params": {
        "ctx": {"label": {"en": "Max context (tokens)", "fr": "Contexte max (tokens)"}, "default": "32768"},
        "parallel": {"label": {"en": "Max parallel sessions", "fr": "Sessions parallèles max"}, "default": "8"},
        "gpu_mem": {"label": {"en": "Share of the VRAM reserved", "fr": "Part de la VRAM réservée"}, "default": "0.90",
                    "values": [["0.90", "90 %"], ["0.80", "80 %"], ["0.70", "70 %"], ["0.95", "95 %"]]}
      }
    }
  },
  "vllm-omni": {
    "label": "vLLM-Omni",
    "desc": {
      "en": "OpenAI server for text-to-speech models (Qwen3-TTS and others): /v1/audio/speech. Needs a CUDA GPU, nightly wheels.",
      "fr": "Serveur OpenAI pour les modèles de synthèse vocale (Qwen3-TTS et autres) : /v1/audio/speech. GPU CUDA requis, wheels nightly."
    },
    "url": "https://github.com/vllm-project/vllm-omni",
    "dir": "~/llm/vllm-omni",
    "detect": ".venv/bin/vllm",
    "script": "vllm-omni.sh",
    "disk_gb": 12,
    "minutes": 15,
    "gpu": ["nvidia"],
    "engine": {
      "label": "vLLM-Omni",
      "kinds": ["tts"],
      "file_ext": [".safetensors"],
      "loads_dir": true,
      "command": ["~/llm/vllm-omni/vllm-omni-serve.sh", "{file_dir}", "--served-model-name", "{model_id}",
                  "--host", "0.0.0.0", "--port", "{port}"],
      "health": "/health",
      "endpoint": "/v1",
      "procs": ["vllm-omni-serve.sh", "vllm"],
      "match_file": true
    }
  },
  "ninfer": {
    "label": "Ninfer",
    "desc": {
      "en": "Specialised CUDA engine for .ninfer models: NVFP4, MTP / DFlash2 speculative decoding, shared KV pool. Blackwell GPUs only (RTX 5090, DGX Spark).",
      "fr": "Moteur CUDA spécialisé pour les modèles .ninfer : NVFP4, décodage spéculatif MTP / DFlash2, pool KV partagé. Réservé aux GPU Blackwell (RTX 5090, DGX Spark)."
    },
    "url": "https://github.com/Neroued/ninfer",
    "dir": "~/llm/ninfer",
    "script": "ninfer.sh",
    "disk_gb": 2,
    "minutes": 20,
    "gpu": ["nvidia"],
    "min_cc": 12.0,
    "engine": {
      "label": "Ninfer",
      "kinds": ["llm"],
      "file_ext": [".ninfer"],
      "command": ["~/llm/ninfer/build/release/apps/ninfer-serve", "{file}", "--host", "0.0.0.0", "--port", "{port}",
                  "--model-id", "{model_id}", "--max-context", "{ctx}",
                  "--max-concurrency", "{concurrency}", "--kv-dtype", "{kv_dtype}",
                  ["--memory-headroom", "{headroom}"], ["--context-capacity", "{context_capacity}"],
                  ["--spec", "{spec}", "--draft-tokens", "{draft}"], "{vision}"],
      "health": "/health",
      "endpoint": "/v1",
      "procs": ["ninfer-serve"],
      "match_file": true,
      "repo": "~/llm/ninfer",
      "build": ["cmake", "--build", "build/release", "--target", "ninfer-serve"],
      "binary": "build/release/apps/ninfer-serve",
      "params": {
        "ctx": {"label": {"en": "Max context (tokens)", "fr": "Contexte max (tokens)"}, "default": "131072"},
        "concurrency": {"label": {"en": "Parallel sessions", "fr": "Sessions parallèles"}, "default": "4"},
        "kv_dtype": {"label": {"en": "KV cache", "fr": "Cache KV"}, "default": "fp8",
                     "values": [["fp8", "FP8"], ["k8v4", "K8V4"], ["nvfp4", "NVFP4"], ["int8", "INT8"], ["bf16", "BF16"]]},
        "headroom": {"label": {"en": "VRAM left free", "fr": "VRAM laissée libre"}, "default": "2GiB"},
        "context_capacity": {"label": {"en": "KV pool size (empty: auto)", "fr": "Taille du pool KV (vide : auto)"}},
        "vision": {"label": "Vision", "default": "on", "map": {"on": "--vision", "off": ""},
                   "values": [["on", {"en": "on", "fr": "activée"}],
                              ["off", {"en": "off (frees VRAM)", "fr": "désactivée (libère de la VRAM)"}]]},
        "spec": {"label": {"en": "Speculative decoding", "fr": "Décodage spéculatif"},
                 "values": [["dflash2", "DFlash2"], ["mtp", "MTP"]]},
        "draft": {"label": {"en": "Draft tokens", "fr": "Tokens de brouillon"}, "default": "7"}
      }
    }
  },
  "laya": {
    "label": "laya-serve",
    "desc": {
      "en": "Server of the Laya decision model (typed choices, yes / no, scores): downloads its own checkpoints. Runs very well on CPU.",
      "fr": "Serveur du modèle de décision Laya (choix typés, oui / non, scores) : télécharge lui-même ses checkpoints. Tourne très bien sur CPU."
    },
    "url": "https://huggingface.co/convaiinnovations/laya",
    "dir": "~/llm/laya",
    "script": "laya.sh",
    "disk_gb": 8,
    "minutes": 5,
    "engine": {
      "label": "laya-serve",
      "kinds": ["decision"],
      "command": ["~/llm/laya/.venv/bin/python", "~/llm/laya/.venv/bin/laya-serve"],
      "env": {
        "LAYA_HOST": "0.0.0.0",
        "LAYA_PORT": "{port}",
        "LAYA_DEVICE": "{device}",
        "LAYA_PRELOAD": "1",
        "HF_HUB_CACHE": "{models_dir}/hf",
        "HF_HUB_OFFLINE": "1"
      },
      "health": "/health",
      "endpoint": "/v1/systemone",
      "procs": ["laya-serve"],
      "device_param": "device",
      "uses": ["hf/models--convaiinnovations--laya"],
      "provides_repos": ["convaiinnovations/laya", "convaiinnovations/laya-multilingual",
                         "convaiinnovations/laya-typed-decisions"],
      "params": {
        "device": {"label": {"en": "Runs on", "fr": "Calcul sur"}, "default": "cpu",
                   "values": [["cpu", "CPU (0 VRAM)"], ["auto", {"en": "auto (GPU if enough VRAM)", "fr": "auto (GPU si assez de VRAM)"}],
                              ["cuda", "GPU"]]}
      }
    }
  }
}
